# Copy to backend/.env and fill in.

# PostgreSQL (Supabase "Session pooler" URI works as-is). Leave unset to use a local SQLite file.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# "gemini" (real agent) or "mock" (offline, rule-based - no API key needed)
LLM_PROVIDER=gemini
# Free key from https://aistudio.google.com -> Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Used when the primary model is busy or out of free-tier quota
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-flash-latest,gemini-3.8-flash

TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TASK_QUEUE=order-supervisor

CORS_ORIGINS=http://localhost:3000
